<div class="password-page page-width section-spacing" style="text-align:center">
  <h1>{{ shop.name }}</h1>
  <p>Opening soon.</p>
  {%- form 'storefront_password' -%}
    <div class="newsletter-form__row" style="justify-content:center">
      <input
        type="password"
        name="password"
        class="newsletter-form__input"
        placeholder="Password"
        aria-label="Password"
      >
      <button type="submit" class="button">Enter</button>
    </div>
    {{ form.errors | default_errors }}
  {%- endform -%}
</div>
