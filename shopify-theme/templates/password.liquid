<div class="password-page">
  <svg class="password-page__web" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
    <circle cx="100" cy="100" r="20"/><circle cx="100" cy="100" r="45"/><circle cx="100" cy="100" r="70"/><circle cx="100" cy="100" r="95"/>
    <line x1="100" y1="100" x2="100" y2="0"/><line x1="100" y1="100" x2="100" y2="200"/>
    <line x1="100" y1="100" x2="0" y2="100"/><line x1="100" y1="100" x2="200" y2="100"/>
    <line x1="100" y1="100" x2="30" y2="30"/><line x1="100" y1="100" x2="170" y2="30"/>
    <line x1="100" y1="100" x2="30" y2="170"/><line x1="100" y1="100" x2="170" y2="170"/>
  </svg>

  <div class="password-page__inner">
    <p class="eyebrow">Born in the Shadows. Built for the Grind.</p>
    <h1 class="password-page__title">{{ shop.name }}</h1>
    <p class="password-page__tagline">Venom in Motion</p>
    <p class="password-page__copy">
      Premium activewear for those who move differently.
      First drop &mdash; the Men's Collection &mdash; arrives 2026.
    </p>

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
      <div class="newsletter-form__row" style="justify-content: center;">
        <input
          type="email"
          name="contact[email]"
          class="newsletter-form__input"
          placeholder="{{ 'newsletter.label' | t }}"
          aria-label="{{ 'newsletter.label' | t }}"
          required
        >
        <button type="submit" class="button">Get Early Access</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="newsletter-form__message">You're in. Watch your inbox.</p>
      {%- endif -%}
    {%- endform -%}
    <p class="password-page__incentive">Early access + launch discount for the list.</p>

    <button type="button" class="password-page__reveal" data-password-reveal onclick="document.querySelector('[data-password-form]').hidden = false; this.hidden = true;">
      Enter with password
    </button>
    <div data-password-form hidden>
      {%- form 'storefront_password' -%}
        <div class="newsletter-form__row" style="justify-content: center;">
          <input
            type="password"
            name="password"
            class="newsletter-form__input"
            placeholder="Password"
            aria-label="Password"
          >
          <button type="submit" class="button button--secondary">Enter</button>
        </div>
        {{ form.errors | default_errors }}
      {%- endform -%}
    </div>
  </div>
</div>
