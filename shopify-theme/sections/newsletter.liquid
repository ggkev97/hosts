<section class="newsletter-section section-spacing-inner">
  <div class="page-width newsletter-section__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form__row">
        <input
          type="email"
          name="contact[email]"
          id="NewsletterEmail-{{ section.id }}"
          class="newsletter-form__input"
          value="{{ form.email }}"
          placeholder="{{ 'newsletter.label' | t }}"
          required
        >
        <button type="submit" class="button">{{ 'newsletter.button_label' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="newsletter-form__message">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay Looped In"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Drop Alerts"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Early access to drops, restocks, and more."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
