<section class="hero{% if section.settings.full_width %} hero--full{% endif %}{% if section.settings.image == blank %} hero--gradient{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                {{ section.settings.image | image_url: width: 1400 }} 1400w,
                {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        {% if section.index == 1 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
      >
    </div>
  {%- endif -%}
  {%- if section.settings.show_web -%}
    <svg class="hero__web" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
      <circle cx="100" cy="100" r="20"/><circle cx="100" cy="100" r="45"/><circle cx="100" cy="100" r="70"/><circle cx="100" cy="100" r="95"/>
      <line x1="100" y1="100" x2="100" y2="0"/><line x1="100" y1="100" x2="100" y2="200"/>
      <line x1="100" y1="100" x2="0" y2="100"/><line x1="100" y1="100" x2="200" y2="100"/>
      <line x1="100" y1="100" x2="30" y2="30"/><line x1="100" y1="100" x2="170" y2="30"/>
      <line x1="100" y1="100" x2="30" y2="170"/><line x1="100" y1="100" x2="170" y2="170"/>
    </svg>
  {%- endif -%}
  <div class="hero__content hero__content--{{ section.settings.content_position }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.show_countdown and section.settings.countdown_date != blank -%}
      <div class="countdown" data-countdown="{{ section.settings.countdown_date | escape }}" hidden>
        <div class="countdown__unit"><span class="countdown__num" data-cd-days>00</span><span class="countdown__label">{{ section.settings.countdown_days_label }}</span></div>
        <div class="countdown__unit"><span class="countdown__num" data-cd-hours>00</span><span class="countdown__label">{{ section.settings.countdown_hours_label }}</span></div>
        <div class="countdown__unit"><span class="countdown__num" data-cd-mins>00</span><span class="countdown__label">{{ section.settings.countdown_mins_label }}</span></div>
        <div class="countdown__unit"><span class="countdown__num" data-cd-secs>00</span><span class="countdown__label">{{ section.settings.countdown_secs_label }}</span></div>
      </div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--large">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Optional — without an image the hero uses a dark gradient backdrop"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Born in the Shadows. Built for the Grind."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Venom in Motion"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium activewear for those who move differently. First drop — the Men's Collection — 2026."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join the Waitlist"
    },
    {
      "type": "checkbox",
      "id": "show_web",
      "label": "Show spiderweb motif",
      "default": true
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "header",
      "content": "Drop countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown",
      "default": false
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Drop date & time",
      "info": "Format: 2026-08-01 18:00 (visitor's local time). Hides automatically once passed."
    },
    {
      "type": "text",
      "id": "countdown_days_label",
      "label": "Days label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "countdown_hours_label",
      "label": "Hours label",
      "default": "Hrs"
    },
    {
      "type": "text",
      "id": "countdown_mins_label",
      "label": "Minutes label",
      "default": "Min"
    },
    {
      "type": "text",
      "id": "countdown_secs_label",
      "label": "Seconds label",
      "default": "Sec"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
