<section class="lookbook page-width section-spacing">
  <div class="section-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="lookbook__grid">
    {%- for block in section.blocks -%}
      <figure class="lookbook__item{% if block.settings.wide %} lookbook__item--wide{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1100 }}"
            srcset="{{ block.settings.image | image_url: width: 550 }} 550w,
                    {{ block.settings.image | image_url: width: 1100 }} 1100w"
            sizes="(min-width: 750px) 33vw, 50vw"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'lookbook__placeholder' }}
        {%- endif -%}
        {%- if block.settings.caption != blank -%}
          <figcaption class="lookbook__caption">{{ block.settings.caption }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Aesthetic"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lookbook"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "checkbox",
          "id": "wide",
          "label": "Double width",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
