<section class="featured-collection page-width section-spacing">
  <div class="section-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="section-link">
        {{ 'products.product.view_details' | t }} {% render 'icon', name: 'arrow-right' %}
      </a>
    {%- endif -%}
  </div>

  <div class="product-grid product-grid--{{ section.settings.columns }}">
    {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
      {% render 'product-card', card_product: product %}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <div class="product-card">
          <div class="product-card__media">
            {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'product-card__placeholder' }}
          </div>
          <h3 class="product-card__title">Example product</h3>
          <div class="price"><span class="price__regular">{{ 4500 | money }}</span></div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "First Drop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Men's Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
