[
  {
    "name": "theme_info",
    "theme_name": "Wardrobe",
    "theme_version": "1.0.0",
    "theme_author": "Custom",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://shopify.dev/docs/storefronts/themes"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#f5f5f2"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#0a0a0b"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card / surface",
        "default": "#141416"
      },
      {
        "type": "color",
        "id": "color_crimson",
        "label": "Crimson (sale, urgency)",
        "default": "#a4161a"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (buttons)",
        "default": "#f5f5f2"
      },
      {
        "type": "color",
        "id": "color_accent_contrast",
        "label": "Accent contrast (button text)",
        "default": "#0a0a0b"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "helvetica_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "helvetica_n4"
      },
      {
        "type": "checkbox",
        "id": "use_brand_fonts",
        "label": "Use brand fonts (Cinzel Decorative + Inter)",
        "info": "Loads from Google Fonts and overrides the pickers above",
        "default": true
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 100,
        "unit": "px",
        "default": 1300
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 2
      }
    ]
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/yourbrand"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X (Twitter)"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Open cart drawer when adding to cart",
        "default": true
      }
    ]
  }
]
